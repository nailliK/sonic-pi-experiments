#!/usr/bin/env ruby
# frozen_string_literal: true

require "find"
require "json"
require "optparse"
require "socket"

LOG_PORT = Integer(ENV["SPI_PORT"] || 4569)
SPIDER_LOG = File.expand_path("~/.sonic-pi/log/spider.log")
HOOK_FILE = File.join(__dir__, "spi_hook.rb")
EXTENSIONS = %w[.rb .spi].freeze
NOISE = [
  "HEAP:",
  "PROCESS STALL",
  "Pausing SuperSonic",
  "[ruby-error]",
  "/server/ruby/"
].freeze
STAMP = /\A\[\d\d:\d\d:\d\d\.\d+\]\s*/.freeze
SECOND = /\A\[(\d\d:\d\d:\d\d)/.freeze

USAGE = <<~TEXT
  spi - drive a running Sonic Pi from the terminal

    spi watch [PATH...]   re-run whenever a watched file changes (default: .)
    spi run FILE          run a file once
    spi stop              stop all jobs
    spi log               stream Sonic Pi's output
    spi info              show the discovered ports and token

  Run "spi COMMAND --help" for the options of a command.
TEXT

module OSC
  module_function

  def pad(str)
    bytes = str.b
    bytes + ("\0" * (4 - (bytes.bytesize % 4)))
  end

  def message(address, *args)
    tags = +","
    body = String.new(encoding: Encoding::BINARY)
    args.each do |arg|
      case arg
      when Integer
        tags << "i"
        body << [arg].pack("l>")
      when Float
        tags << "f"
        body << [arg].pack("g")
      else
        tags << "s"
        body << pad(arg.to_s)
      end
    end
    pad(address) + pad(tags) + body
  end

  def send(port, address, *args)
    socket = UDPSocket.new
    socket.send(message(address, *args), 0, "127.0.0.1", port)
  ensure
    socket&.close
  end
end

class SonicPi
  NotRunning = Class.new(StandardError)
  PS = ["ps -Awwo pid=,args=", "ps -eww -o pid=,args="].freeze

  attr_reader :pid, :listen, :gui, :scsynth, :scsynth_send, :cues, :token

  def self.processes
    PS.each do |command|
      output = `#{command} 2>/dev/null`
      return output if $?&.success? && !output.strip.empty?
    end
    ""
  end

  def self.discover
    processes.each_line do |line|
      next unless line.include?("spider-server.rb")
      next if line.include?("-o pid=")

      tail = line.split("spider-server.rb", 2).last.split
      tail.shift if %w[-u -t].include?(tail.first)
      ports = tail.grep(/\A-?\d+\z/).map(&:to_i)
      next if ports.size < 6

      return new(line.split(nil, 2).first.to_i, *ports.first(6))
    end

    raise NotRunning, "no running Sonic Pi found - start Sonic Pi and wait for it to boot"
  end

  def initialize(pid, listen, gui, scsynth, scsynth_send, cues, token)
    @pid = pid
    @listen = listen
    @gui = gui
    @scsynth = scsynth
    @scsynth_send = scsynth_send
    @cues = cues
    @token = token
  end

  def run(code, workspace)
    OSC.send(listen, "/run-code", token, code, workspace)
  end

  def stop
    OSC.send(listen, "/stop-all-jobs", token)
  end
end

module Hook
  module_function

  def signature
    "#{LOG_PORT}:#{File.mtime(HOOK_FILE).to_i}"
  end

  def prelude
    <<~LINE.chomp + "\n"
      begin; @spi_port = #{LOG_PORT}; eval(File.read(#{HOOK_FILE.inspect}), nil, "spi_hook") unless @spi_hooked == #{signature.inspect}; @spi_hooked = #{signature.inspect}; rescue => e; puts "spi hook: \#{e}"; end #__nosave__
    LINE
  end
end

class Monitor
  COLOURS = {
    "puts" => nil,
    "cue" => "36",
    "info" => "2",
    "job" => "2",
    "pi" => "2",
    "error" => "31",
    "spi" => "1"
  }.freeze

  def initialize(show_all: false)
    @show_all = show_all
    @lock = Mutex.new
    @colour = $stdout.tty?
  end

  def start
    Thread.new { receive }
    Thread.new { tail }
    sleep 0.2
    self
  end

  def say(kind, text)
    line = format("[%s] %-5s %s", Time.now.strftime("%H:%M:%S.%L"), kind, text)
    colour = COLOURS[kind]
    line = "\e[#{colour}m#{line}\e[0m" if colour && @colour
    @lock.synchronize { $stdout.puts(line) }
  end

  private

  def receive
    socket = UDPSocket.new
    socket.bind("127.0.0.1", LOG_PORT)
    loop do
      data, = socket.recvfrom(65_536)
      begin
        render(JSON.parse(data))
      rescue JSON::ParserError
        next
      end
    end
  rescue StandardError => e
    say("spi", "not receiving Sonic Pi output: #{e}")
  end

  def render(msg)
    case msg["t"]
    when "puts"
      where = msg["thread"].to_s
      Array(msg["lines"]).each do |text|
        say("puts", where.empty? ? text : format("%-22s %s", where, text))
      end
    when "cue"
      args = msg["args"].to_s
      args = "" if ["[]", "{}", "nil"].include?(args)
      say("cue", [msg["address"], args].reject { |part| part.to_s.empty? }.join("  "))
    when "info"
      say("info", msg["msg"].to_s)
    when "job"
      say("job", "run #{msg['job']} #{msg['action']}")
    when "error"
      head, *rest = msg["msg"].to_s.split("\n").map(&:strip).reject(&:empty?)
      say("error", "run #{msg['job']} line #{msg['line']}  #{head}")
      source = msg["source"].to_s.strip
      say("error", "  #{source}") unless source.empty?
      (rest + Array(msg["trace"])).each { |line| say("error", "  #{line}") }
    when "exit"
      say("info", "sonic pi exited")
    end
  end

  def tail
    previous = nil
    muted = nil
    loop do
      file = File.open(SPIDER_LOG)
      file.seek(0, IO::SEEK_END)
      loop do
        raw = file.gets
        if raw.nil?
          break if truncated?(file)

          sleep 0.05
          next
        end

        raw = raw.chomp.scrub
        second = raw[SECOND, 1]
        if !@show_all && NOISE.any? { |noise| raw.include?(noise) }
          muted = second
          next
        end
        next if !@show_all && second && second == muted

        line = raw.sub(STAMP, "")
        next if line.empty? || line == previous

        previous = line
        say("pi", line)
      end
      file.close
    end
  rescue StandardError => e
    say("spi", "not tailing #{SPIDER_LOG}: #{e}")
  end

  def truncated?(file)
    File.size(SPIDER_LOG) < file.pos
  rescue StandardError
    false
  end
end

def short(path)
  full = File.expand_path(path)
  full.start_with?("#{Dir.pwd}/") ? full.sub("#{Dir.pwd}/", "") : full
end

class Session
  def initialize(sonic_pi, monitor, options)
    @sonic_pi = sonic_pi
    @monitor = monitor
    @options = options
  end

  def say(text)
    @monitor.say("spi", text)
  end

  def fire(path)
    code = File.read(path)
    name = short(path)

    if code[0, 512].to_s.include?("spi:ignore")
      say("- #{name} (spi:ignore)")
      return
    end

    if code.strip.empty?
      @sonic_pi.stop
      say(". #{name} is empty - stopped all jobs")
      return
    end

    if @options[:stop_first]
      @sonic_pi.stop
      sleep 0.05
    end

    code = Hook.prelude + code unless @options[:no_hook]
    @sonic_pi.run(code, File.expand_path(path))
    say("> #{name}")
  rescue StandardError => e
    say("! #{short(path)}: #{e}")
  end
end

class Watcher
  def initialize(paths, exclude)
    @paths = paths
    @exclude = exclude
  end

  def collect
    found = {}
    @paths.each do |path|
      if File.directory?(path)
        walk(path, found)
      else
        found[File.expand_path(path)] = mtime(path)
      end
    end
    found
  end

  private

  def walk(root, found)
    Find.find(root) do |path|
      name = File.basename(path)
      if File.directory?(path)
        Find.prune if path != root && (name.start_with?(".") || excluded?(name))
        next
      end
      next if name.start_with?(".") || !EXTENSIONS.include?(File.extname(path))

      found[File.expand_path(path)] = mtime(path)
    end
  end

  def excluded?(name)
    @exclude.any? { |glob| File.fnmatch?(glob, name) }
  end

  def mtime(path)
    File.mtime(path)
  rescue StandardError
    nil
  end
end

def wait_for_interrupt
  puts "  ctrl-c to quit"
  sleep
rescue Interrupt
  puts "\nbye"
end

def cmd_run(sonic_pi, options)
  path = options[:paths].first
  abort("spi: usage: spi run FILE") unless path
  abort("spi: no such file: #{path}") unless File.file?(path)

  monitor = Monitor.new(show_all: options[:all])
  monitor.start if options[:log]
  Session.new(sonic_pi, monitor, options).fire(path)
  wait_for_interrupt if options[:log]
  0
end

def cmd_watch(sonic_pi, options)
  entry = options[:exec]
  abort("spi: no such file: #{entry}") if entry && !File.file?(entry)

  paths = options[:paths]
  paths = ["."] if paths.empty?
  paths += [entry] if entry

  monitor = Monitor.new(show_all: options[:all])
  monitor.start if options[:log]
  session = Session.new(sonic_pi, monitor, options)
  watcher = Watcher.new(paths, options[:exclude])

  seen = watcher.collect
  puts "watching #{paths.map { |path| short(path) }.join(', ')} (pid #{sonic_pi.pid}, port #{sonic_pi.listen})"
  puts "  #{seen.size} file(s), extensions: #{EXTENSIONS.join(' ')}"
  puts "  excluding: #{options[:exclude].join(' ')}" unless options[:exclude].empty?
  puts "  any change re-runs #{short(entry)}" if entry

  if options[:run_now]
    entry ? session.fire(entry) : seen.keys.sort.each { |path| session.fire(path) }
  end
  puts "  ctrl-c to quit"

  loop do
    sleep options[:interval]
    current = watcher.collect
    changed = current.reject { |path, time| time.nil? || seen[path] == time }.keys
    removed = entry ? seen.keys - current.keys : []
    seen = current
    next if changed.empty? && removed.empty?

    sleep options[:interval]
    seen = watcher.collect

    if entry
      triggers = changed.sort + (removed.sort - seen.keys)
      next if triggers.empty?

      session.say("~ #{triggers.map { |path| short(path) }.join(', ')}")
      session.fire(entry)
    else
      changed.sort.each { |path| session.fire(path) }
    end
  end
rescue Interrupt
  puts "\nbye"
  0
end

def cmd_stop(sonic_pi, _options)
  sonic_pi.stop
  puts "stopped all jobs"
  0
end

def cmd_log(_sonic_pi, options)
  puts "streaming Sonic Pi output (udp #{LOG_PORT}, #{SPIDER_LOG})"
  Monitor.new(show_all: options[:all]).start
  wait_for_interrupt
  0
end

def cmd_info(sonic_pi, _options)
  puts "pid           #{sonic_pi.pid}"
  puts "send to       127.0.0.1:#{sonic_pi.listen}"
  puts "gui port      #{sonic_pi.gui}"
  puts "scsynth       #{sonic_pi.scsynth} (send #{sonic_pi.scsynth_send})"
  puts "osc cues      #{sonic_pi.cues}"
  puts "token         #{sonic_pi.token}"
  0
end

def parse(argv)
  options = {
    paths: [],
    exclude: [],
    interval: 0.2,
    stop_first: false,
    log: false,
    all: false,
    run_now: false,
    no_hook: false,
    exec: nil
  }

  command = argv.shift
  abort(USAGE) if command.nil? || %w[-h --help help].include?(command)

  parser = OptionParser.new do |opts|
    opts.banner = "usage: spi #{command} [options]"

    case command
    when "run"
      opts.banner = "usage: spi run FILE [options]"
      opts.on("-s", "--stop-first", "stop all jobs before running") { options[:stop_first] = true }
      opts.on("-l", "--log", "stream Sonic Pi's output until ctrl-c") { options[:log] = true }
    when "watch"
      opts.banner = "usage: spi watch [PATH...] [options]"
      options[:stop_first] = true
      opts.on("-x", "--exec FILE", "re-run FILE on any change") { |v| options[:exec] = v }
      opts.on("-X", "--exclude GLOB", "directory name to skip (repeatable)") { |v| options[:exclude] << v }
      opts.on("-i", "--interval SECS", Float, "poll interval (default: 0.2)") { |v| options[:interval] = v }
      opts.on("-n", "--run-now", "run once on startup") { options[:run_now] = true }
      opts.on("-S", "--no-stop-first", "leave running jobs alone") { options[:stop_first] = false }
      opts.on("-l", "--log", "also stream Sonic Pi's output here") { options[:log] = true }
    when "log", "stop", "info"
      nil
    else
      abort(USAGE)
    end

    opts.on("-a", "--all", "include heap and studio noise") { options[:all] = true } if %w[run watch log].include?(command)
    opts.on("-H", "--no-hook", "do not install the Sonic Pi log hook") { options[:no_hook] = true } if %w[run watch].include?(command)
    opts.on("-h", "--help", "show this message") { puts opts; exit 0 }
  end

  parser.parse!(argv)
  options[:paths] = argv
  [command, options]
end

def main(argv)
  $stdout.sync = true
  command, options = parse(argv)

  sonic_pi = SonicPi.discover
  case command
  when "run" then cmd_run(sonic_pi, options)
  when "watch" then cmd_watch(sonic_pi, options)
  when "stop" then cmd_stop(sonic_pi, options)
  when "log" then cmd_log(sonic_pi, options)
  when "info" then cmd_info(sonic_pi, options)
  end
rescue SonicPi::NotRunning => e
  abort("spi: #{e}")
end

exit(main(ARGV) || 0)
